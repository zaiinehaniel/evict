      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar apps ociosos automaticamente"
          }
        }
      }
    },
    "Evict never closes the app you're using, or apps playing audio, in a call, keeping the Mac awake or busy working. Apps always quit gracefully, like pressing ⌘Q.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Evict nunca fecha o app que você está usando, nem apps tocando áudio, em chamada, mantendo o Mac acordado ou trabalhando. Os apps sempre fecham com cuidado, como ao pressionar ⌘Q."
          }
        }
      }
    },
    "Evict never connects to the internet and collects no data.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Evict nunca se conecta à internet e não coleta nenhum dado."
