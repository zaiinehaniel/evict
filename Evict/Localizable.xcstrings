    "Give an app its own idle time, or choose Never to protect it. Other apps use the default (%@).": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a um app seu próprio tempo ocioso, ou escolha Nunca para protegê-lo. Os outros apps usam o padrão (%@)."
